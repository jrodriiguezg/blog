---
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

// Quitar o poner el prefijo /en de forma inteligente
const targetPath = lang === 'en'
	? currentPath.replace(/^\/en/, '') || '/'
	: `/en${currentPath === '/' ? '' : currentPath}`;

const targetLang = lang === 'en' ? 'ES' : 'EN';
const targetLabel = lang === 'en' ? 'Cambiar a Español' : 'Switch to English';
---

<a href={targetPath} class="lang-toggle" title={targetLabel} data-lang={lang === 'en' ? 'es' : 'en'}>
	{targetLang}
</a>

<script>
	document.querySelectorAll('.lang-toggle').forEach(el => {
		el.addEventListener('click', () => {
			const targetLang = el.getAttribute('data-lang');
			if (targetLang) {
				document.cookie = `lang=${targetLang};path=/;max-age=31536000`; // 1 year
			}
		});
	});
</script>

<style>
	.lang-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 500;
		color: var(--text-muted);
		text-decoration: none !important;
		height: 36px;
		min-width: 36px;
		padding: 0 10px;
		border: 1px solid var(--border-color);
		border-radius: var(--radius);
		transition: color 0.15s ease, border-color 0.15s ease;
		background: transparent;
		box-sizing: border-box;
		line-height: 1;
	}
	.lang-toggle:hover {
		color: var(--title-color);
		border-color: var(--border-hover);
		text-decoration: none !important;
	}
	.lang-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	@media (max-width: 639px) {
		.lang-toggle {
			height: 34px;
			min-width: 34px;
			padding: 0 8px;
			font-size: 0.75rem;
		}
	}
</style>
