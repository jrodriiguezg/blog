---
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/ui';
import SearchModal from './SearchModal.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = useTranslatedPath(lang);

const currentPath = Astro.url.pathname;
const cleanPath = currentPath.endsWith('/') && currentPath !== '/' ? currentPath.slice(0, -1) : currentPath;

// Determinar si la sección blog está activa (en inicio, listados, categorías, tags o artículos)
const isBlogActive =
	cleanPath === '' ||
	cleanPath === '/' ||
	cleanPath === '/en' ||
	cleanPath.startsWith('/blog') ||
	cleanPath.startsWith('/en/blog');
---

<header class="site-header">
	<div class="header-container">
		<div class="header-left">
			<a href={l('/')} class="header-logo">
				jrodriiguezg<span class="logo-tld">.link</span>
			</a>
			<nav class="header-nav desktop-nav" aria-label="Navegación principal">
				<a href={l('/')} class:list={[{ active: isBlogActive }]}>{t('nav.blog')}</a>
				<a href="https://jrodriiguezg.link" target="_blank" rel="noopener noreferrer">{t('nav.about')}</a>
			</nav>
		</div>

		<div class="header-right">
			<button class="header-icon-btn search-trigger-btn" data-open-search aria-label="Abrir búsqueda" title="Buscar (Ctrl+K)">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
			</button>

			<a href="https://github.com/jrodriiguezg" target="_blank" rel="noopener noreferrer" class="header-icon-btn" title="GitHub" aria-label="GitHub">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
				</svg>
			</a>

			<a href="https://huggingface.co/jrodriiguezg" target="_blank" rel="noopener noreferrer" class="header-icon-btn" title="Hugging Face" aria-label="Hugging Face">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="9"></circle>
					<path d="M9 10h.01"></path>
					<path d="M15 10h.01"></path>
					<path d="M9.5 15a3.5 3.5 0 0 0 5 0"></path>
				</svg>
			</a>

			<LanguagePicker />
			<ThemeToggle />
		</div>
	</div>

	<!-- Fila compacta de navegación para pantallas móviles (<640px) -->
	<div class="mobile-nav-bar">
		<nav class="header-nav mobile-nav" aria-label="Navegación móvil">
			<a href={l('/')} class:list={[{ active: isBlogActive }]}>{t('nav.blog')}</a>
			<a href="https://jrodriiguezg.link" target="_blank" rel="noopener noreferrer">{t('nav.about')}</a>
		</nav>
	</div>
</header>
<SearchModal />

<style>
	/* Header Container - Sticky sólido, sin blur, altura fija en escritorio */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		background-color: var(--bg-color);
		border-bottom: 1px solid var(--border-color);
		box-shadow: none;
	}

	/* Reset explícito de estilos por defecto para evitar herencias globales de <a> */
	.site-header :global(a) {
		color: var(--text-muted);
		text-decoration: none !important;
		transition: color 0.15s ease;
	}

	.header-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		max-width: var(--container-width);
		height: 58px;
		margin: 0 auto;
		padding: 0 1.25rem;
		box-sizing: border-box;
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 2rem;
		min-width: 0;
	}

	/* Logo de texto en peso medio, sin subrayado, .link en color secundario */
	.header-logo {
		font-family: var(--font-mono);
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--title-color) !important;
		text-decoration: none !important;
		letter-spacing: -0.015em;
		white-space: nowrap;
		display: inline-flex;
		align-items: center;
	}

	.header-logo .logo-tld {
		color: var(--text-muted);
		font-weight: 400;
	}

	.header-logo:hover {
		color: var(--title-color) !important;
		text-decoration: none !important;
	}

	.header-logo:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	/* Enlaces de navegación */
	.header-nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.header-nav a {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--text-muted) !important;
		text-decoration: none !important;
		line-height: 1;
		transition: color 0.15s ease, text-decoration-color 0.15s ease;
	}

	.header-nav a:hover {
		color: var(--title-color) !important;
		text-decoration: none !important;
	}

	/* Enlace activo: color principal y subrayado 1px con offset 6px (no un color distinto) */
	.header-nav a.active {
		color: var(--title-color) !important;
		text-decoration: underline !important;
		text-decoration-thickness: 1px !important;
		text-underline-offset: 6px !important;
		text-decoration-color: var(--title-color) !important;
	}

	.header-nav a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	/* Acciones a la derecha: iconos lineales, gap uniforme de 16px */
	.header-right {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	/* Iconos lineales con área clicable de 36px y foco visible */
	.header-icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		margin: 0;
		background: transparent;
		border: 1px solid transparent;
		border-radius: var(--radius);
		color: var(--text-muted) !important;
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease;
		box-sizing: border-box;
	}

	.header-icon-btn:hover {
		color: var(--title-color) !important;
	}

	.header-icon-btn:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* Fila móvil oculta por defecto en desktop */
	.mobile-nav-bar {
		display: none;
	}

	/* Responsive móvil (<640px) */
	@media (max-width: 639px) {
		.header-container {
			height: 52px;
			padding: 0 1rem;
		}

		.header-left {
			gap: 0;
		}

		.desktop-nav {
			display: none;
		}

		.header-right {
			gap: 10px;
		}

		.header-icon-btn {
			width: 34px;
			height: 34px;
		}

		/* Fila secundaria móvil horizontal, compacta, nunca apilada con subrayados raros */
		.mobile-nav-bar {
			display: block;
			width: 100%;
			border-top: 1px solid var(--border-color);
			background-color: var(--bg-color);
		}

		.mobile-nav {
			display: flex;
			align-items: center;
			gap: 1.5rem;
			max-width: var(--container-width);
			margin: 0 auto;
			padding: 0 1rem;
			height: 38px;
			box-sizing: border-box;
		}

		.mobile-nav a {
			font-size: 0.85rem;
		}
	}

	@media (max-width: 480px) {
		.header-container {
			padding: 0 0.85rem;
		}
		.mobile-nav {
			padding: 0 0.85rem;
		}
	}
</style>
