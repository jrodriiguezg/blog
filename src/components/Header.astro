				</a>
				<a href="https://ko-fi.com/jrodriiguezg" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Ko-fi</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="currentColor">
						<path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.051-3.954-1.094-1.465-1.083-3.262 0-4.198 1.116-.916 2.79-.843 3.995.212.352.312.593.636.593.636s.202-.308.514-.6A4.331 4.331 0 0 1 12.87 8.07c1.196-.906 2.87-.978 3.996-.061 1.083.936 1.094 2.733 0 4.198z"></path>
					</svg>
				</a>
			</div>
			<ThemeToggle />
		</div>
	</nav>
</header>
<SearchModal />
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--header-bg);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid rgba(var(--gray), 15%);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--title-color);
		transition: color 0.3s ease;
		letter-spacing: -0.02em;
		font-weight: 700;
	}
	.logo-dot {
		color: #2337ff;
		text-shadow: 0 0 8px rgba(35, 55, 255, 0.8), 0 0 20px rgba(35, 55, 255, 0.4);
		font-weight: 900;
		transition: color 0.3s ease, text-shadow 0.3s ease;
		display: inline-block;
	}
	:global(html.dark) .logo-dot {
		color: #58a6ff;
		text-shadow: 0 0 8px rgba(88, 166, 255, 0.9), 0 0 20px rgba(88, 166, 255, 0.5);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--text-color);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: color 0.3s ease, border-color 0.3s ease;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		color: var(--title-color);
	}
	.right-section {
		display: flex;
		align-items: center;
		gap: 1.25em;
	}
	.search-trigger-btn {
		background: transparent;
		border: none;
		color: var(--text-color);
		cursor: pointer;
		padding: 0.5em;
		display: flex;
		align-items: center;
		transition: color 0.3s ease, transform 0.2s ease;
	}
	.search-trigger-btn:hover {
		color: var(--accent);
		transform: scale(1.05);
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
	}
	.social-links a {
		color: var(--text-color);
		transition: color 0.3s ease;
		padding: 0.5em;
	}
	.social-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
