---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/ui';
import SearchModal from './SearchModal.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = useTranslatedPath(lang);
---

<header>
	<nav>
		<h2>
			<a href={l('/')}>
				jrodriiguezg<span class="logo-dot">.</span>link
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={l('/')}>{t('nav.blog')}</HeaderLink>
			<HeaderLink href={l('/configuraciones')}>{t('nav.configurations')}</HeaderLink>
			<HeaderLink href={l('/about')}>{t('nav.about')}</HeaderLink>
		</div>
		<div class="right-section">
			<button class="search-trigger-btn" data-open-search aria-label="Abrir búsqueda" title="Buscar (Ctrl+K)">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
			</button>
			<LanguagePicker />
			<div class="social-links">
				<a href="https://www.instagram.com/jrodriiguezg.link/?hl=es" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Instagram</span>
