---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { MAIN_SITE_URL } from '../consts';

const today = new Date();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="site-footer">
	<div class="footer-container">
		<span class="footer-copy">
			{t('footer.by')} <a href={MAIN_SITE_URL} rel="noopener" class="footer-link">jrodriiguezg.link</a> &copy; {today.getFullYear()}
		</span>
		<div class="footer-links">
			<a href="/rss.xml" class="footer-link">RSS</a>
			<span class="footer-separator">·</span>
			<a href="https://github.com/jrodriiguezg" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		width: 100%;
		padding: 3rem 0;
		border-top: 1px solid var(--border-color);
		background-color: var(--bg-color);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.84rem; /* ~13.5px */
		line-height: 1.5;
	}

	.footer-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		width: 100%;
		max-width: var(--container-width);
		margin: 0 auto;
		padding: 0 1.25rem;
		box-sizing: border-box;
	}

	.footer-copy {
		color: var(--text-muted);
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.footer-separator {
		color: var(--border-color);
		user-select: none;
	}

	/* Enlaces del pie: sin subrayado por defecto, color secundario, hover al color principal */
	.site-footer :global(a),
	.footer-link {
		color: var(--text-muted) !important;
		text-decoration: none !important;
		transition: color 0.15s ease;
	}

	.site-footer :global(a:hover),
	.footer-link:hover {
		color: var(--title-color) !important;
		text-decoration: none !important;
	}

	.site-footer :global(a:focus-visible),
	.footer-link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	@media (max-width: 720px) {
		.footer-container {
			padding: 0 1rem;
		}
	}

	@media (max-width: 639px) {
		.site-footer {
			padding: 2.25rem 0;
		}

		.footer-container {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.6rem;
		}
	}

	@media (max-width: 480px) {
		.footer-container {
			padding: 0 0.85rem;
		}
	}
</style>
