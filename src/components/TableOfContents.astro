---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  lang?: string;
}

const { headings, lang = 'es' } = Astro.props;
const tocHeadings = (headings || []).filter((h) => h.depth >= 2 && h.depth <= 3);
const titleText = lang === 'en' ? 'Table of contents' : 'Índice de contenidos';
---

{tocHeadings.length > 0 && (
  <details class="toc-inline-box" open>
    <summary class="toc-header">
      <div class="toc-header-left">
        <svg class="toc-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span class="toc-title">{titleText}</span>
      </div>
      <svg class="toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </summary>
    <nav class="toc-content">
      <ol class="toc-list">
        {tocHeadings.map((h) => (
          <li class={`toc-item depth-${h.depth}`}>
            <a href={`#${h.slug}`} class="toc-link">
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}

<style>
  .toc-inline-box {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    margin: 2rem 0 2.5rem 0;
    padding: 0;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .toc-inline-box:hover {
    border-color: var(--border-color);
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.25rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--title-color);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .toc-header::-webkit-details-marker {
    display: none;
  }

  .toc-header-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .toc-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  .toc-title {
    letter-spacing: -0.01em;
  }

  .toc-chevron {
    color: var(--text-muted);
    transition: transform 0.25s ease;
  }

  details[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-content {
    padding: 0 1.25rem 1.25rem 1.25rem;
    border-top: 1px solid var(--border-color);
  }

  .toc-list {
    margin: 1rem 0 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .toc-item {
    line-height: 1.45;
  }

  .depth-2 {
    font-weight: 500;
  }

  .depth-3 {
    padding-left: 1.25rem;
    font-size: 0.88rem;
    position: relative;
  }

  .depth-3::before {
    content: "↳";
    position: absolute;
    left: 0.35rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .toc-link {
    color: var(--text-color);
    text-decoration: none;
    transition: color 0.15s ease;
    display: inline-block;
  }

  .toc-link:hover {
    color: var(--accent);
  }
</style>
