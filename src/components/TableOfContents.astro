---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  lang?: string;
}

const { headings, lang = 'es' } = Astro.props;
const tocHeadings = (headings || []).filter(h => h.depth >= 2 && h.depth <= 3);
const titleText = lang === 'en' ? 'On this page' : 'En esta página';
---

{tocHeadings.length > 0 && (
  <nav class="toc-sidebar" aria-label={titleText}>
    <p class="toc-title">{titleText}</p>
    <ul class="toc-list">
      {tocHeadings.map(h => (
        <li class={`toc-item depth-${h.depth}`}>
          <a href={`#${h.slug}`} class="toc-link" data-toc-slug={h.slug}>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc-sidebar {
    position: sticky;
    top: 5.5rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding: 1.25rem 1rem;
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
  }

  .toc-title {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    padding-left: 0.5rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin: 0;
  }

  .toc-link {
    display: block;
    padding: 0.35rem 0.65rem;
    font-size: 0.83rem;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: all 0.15s ease;
    line-height: 1.4;
    border-radius: 0 4px 4px 0;
  }

  .toc-link:hover {
    color: var(--title-color);
    border-left-color: var(--accent);
    background: rgba(0, 0, 0, 0.03);
  }

  :global(html.dark) .toc-link:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .toc-link.active {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  .depth-3 .toc-link {
    padding-left: 1.25rem;
    font-size: 0.78rem;
  }
</style>

<script>
  function initTOC() {
    const headingElements = document.querySelectorAll('.prose :where(h2, h3)');
    const tocLinks = document.querySelectorAll('.toc-link[data-toc-slug]');

    if (headingElements.length > 0 && tocLinks.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length > 0) {
            const activeId = visible[0].target.id;
            tocLinks.forEach((link) => {
              link.classList.toggle('active', link.getAttribute('data-toc-slug') === activeId);
            });
          }
        },
        {
          rootMargin: '-70px 0px -65% 0px',
          threshold: 0,
        }
      );

      headingElements.forEach((el) => {
        if (el.id) observer.observe(el);
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initTOC);
</script>
