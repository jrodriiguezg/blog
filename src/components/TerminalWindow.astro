---
export interface Props {
  title?: string;
}

const { title = "bash" } = Astro.props;
---

<div class="terminal-container">
  <div class="terminal-header">
    <div class="terminal-dots">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
    </div>
    <div class="terminal-title" title={title}>{title}</div>
  </div>
  <div class="terminal-body">
    <slot />
  </div>
</div>

<style>
  .terminal-container {
    background-color: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    margin: 1.75rem 0;
    overflow: hidden;
    max-width: 100%;
    width: 100%;
  }

  .terminal-header {
    background-color: var(--surface-hover);
    padding: 0.4rem 0.85rem;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    min-width: 0;
  }

  .terminal-dots {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--border-hover);
  }

  .terminal-title {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-left: 0.75rem;
    user-select: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    flex: 1;
  }

  .terminal-body {
    padding: 0.85rem 1rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    font-size: 0.88rem;
  }

  .terminal-body :global(pre) {
    margin: 0 !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    overflow-x: auto !important;
    max-width: 100%;
  }

  @media (max-width: 640px) {
    .terminal-header {
      padding: 0.35rem 0.65rem;
    }
    .terminal-title {
      font-size: 0.74rem;
      margin-left: 0.5rem;
    }
    .terminal-body {
      padding: 0.75rem 0.65rem;
      font-size: 0.82rem;
    }
  }
</style>
