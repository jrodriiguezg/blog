---
export interface Props {
  title?: string;
}

const { title = "code" } = Astro.props;
---

<div class="code-window-container">
  <div class="code-window-header">
    <div class="code-window-tab" title={title}>
      <span class="code-window-title">{title}</span>
    </div>
  </div>
  <div class="code-window-body">
    <slot />
  </div>
</div>

<style>
  .code-window-container {
    background-color: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    margin: 1.75rem 0;
    overflow: hidden;
    max-width: 100%;
    width: 100%;
  }

  .code-window-header {
    background-color: var(--surface-hover);
    display: flex;
    align-items: flex-end;
    border-bottom: 1px solid var(--border-color);
    height: 34px;
    padding-left: 0.5rem;
    min-width: 0;
    overflow: hidden;
  }

  .code-window-tab {
    background-color: var(--surface-color);
    border-left: 1px solid var(--border-color);
    border-right: 1px solid var(--border-color);
    border-top: 2px solid var(--accent);
    border-top-left-radius: var(--radius-sm);
    border-top-right-radius: var(--radius-sm);
    padding: 0 0.85rem;
    display: flex;
    align-items: center;
    height: calc(100% + 1px);
    margin-bottom: -1px;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .code-window-title {
    color: var(--text-color);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    user-select: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .code-window-body {
    padding: 0.85rem 1rem;
    background-color: var(--surface-color);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    font-size: 0.88rem;
  }

  .code-window-body :global(pre) {
    margin: 0 !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    overflow-x: auto !important;
    max-width: 100%;
  }

  @media (max-width: 640px) {
    .code-window-header {
      height: 30px;
      padding-left: 0.4rem;
    }
    .code-window-tab {
      padding: 0 0.65rem;
    }
    .code-window-title {
      font-size: 0.74rem;
    }
    .code-window-body {
      padding: 0.75rem 0.65rem;
      font-size: 0.82rem;
    }
  }
</style>
