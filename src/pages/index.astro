---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
	.filter((post) => !post.id.startsWith('en/'))
	.sort((a, b) => {
		if (a.data.pinned && !b.data.pinned) return -1;
		if (!a.data.pinned && b.data.pinned) return 1;
		return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
	});

function getReadingTime(body?: string) {
	if (!body) return '3 min';
	const words = body.trim().split(/\s+/).length;
	const minutes = Math.max(1, Math.ceil(words / 200));
	return `${minutes} min`;
}

const featuredPost = posts[0];
const regularPosts = posts.slice(1);

const categoryTitles: Record<string, string> = {
	proyectos: 'Proyectos',
	divulgacion: 'Divulgación',
	miscelanea: 'Miscelánea',
	'mi-pc': 'Mi PC',
	homelab: 'HomeLab',
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.category-tabs {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 2.5rem;
				justify-content: center;
				padding: 0.35rem;
				background: var(--surface-color);
				border: 1px solid var(--border-color);
				border-radius: var(--radius);
			}
			.category-tabs a {
				padding: 0.4rem 0.9rem;
				text-decoration: none;
				color: var(--text-muted);
				border-radius: var(--radius-sm);
				font-size: 0.9rem;
				font-weight: 500;
				transition: background-color 0.2s ease, color 0.2s ease;
			}
			.category-tabs a:hover {
				background: var(--bg-color);
				color: var(--title-color);
			}
			.category-tabs a.active {
				background: var(--accent);
				color: #ffffff;
				font-weight: 600;
			}

			/* Featured Post Card */
			.featured-section {
				margin-bottom: 2.5rem;
			}
			.featured-card {
				display: grid;
				grid-template-columns: 1.15fr 1fr;
				background: var(--card-bg);
				border: 1px solid var(--border-color);
				border-radius: var(--radius);
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				box-shadow: var(--box-shadow);
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
			}
			.featured-card:hover {
				transform: translateY(-3px);
				border-color: var(--accent);
				box-shadow: var(--box-shadow-hover);
			}
			.featured-image-wrapper {
				position: relative;
				overflow: hidden;
				background: var(--surface-color);
				min-height: 280px;
			}
			.featured-image-wrapper img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				border-radius: 0;
			}
			.featured-content {
				padding: 2rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.featured-title {
				font-size: 1.6rem;
				line-height: 1.3;
				margin: 0.75rem 0;
				color: var(--title-color);
				transition: color 0.2s ease;
			}
			.featured-card:hover .featured-title {
				color: var(--accent);
			}
			.featured-desc {
				font-size: 0.95rem;
				color: var(--text-color);
				line-height: 1.6;
				margin-bottom: 1.5rem;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.featured-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.85rem;
				color: var(--text-muted);
				margin-top: auto;
				padding-top: 1rem;
				border-top: 1px solid var(--border-color);
			}

			/* Grid of Posts */
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
				gap: 1.5rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-card {
				display: flex;
				flex-direction: column;
				background: var(--card-bg);
				border: 1px solid var(--border-color);
				border-radius: var(--radius);
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				box-shadow: var(--box-shadow);
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
			}
			.post-card:hover {
				transform: translateY(-3px);
				border-color: var(--accent);
				box-shadow: var(--box-shadow-hover);
			}
			.card-image-wrapper {
				position: relative;
				width: 100%;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: var(--surface-color);
			}
			.card-image-wrapper img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				border-radius: 0;
			}
			.card-content {
				padding: 1.25rem;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.card-meta {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.5rem;
				flex-wrap: wrap;
			}
			.card-title {
				font-size: 1.15rem;
				line-height: 1.35;
				margin: 0.25rem 0 0.5rem 0;
				color: var(--title-color);
				transition: color 0.2s ease;
			}
			.post-card:hover .card-title {
				color: var(--accent);
			}
			.card-desc {
				font-size: 0.88rem;
				color: var(--text-color);
				line-height: 1.55;
				margin-bottom: 1.25rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.card-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.82rem;
				color: var(--text-muted);
				margin-top: auto;
				padding-top: 0.75rem;
				border-top: 1px solid var(--border-color);
			}
			.read-action {
				font-weight: 600;
				color: var(--accent);
			}
			.reading-time {
				font-size: 0.75rem;
				color: var(--text-muted);
			}

			/* Category Badges */
			.category-badge {
				display: inline-block;
				padding: 0.2rem 0.5rem;
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				border-radius: 4px;
				letter-spacing: 0.03em;
				border: 1px solid transparent;
			}
			.category-badge.proyectos {
				background: rgba(59, 130, 246, 0.12);
				color: #2563eb;
				border-color: rgba(59, 130, 246, 0.25);
			}
			:global(html.dark) .category-badge.proyectos {
				color: #60a5fa;
			}
			.category-badge.divulgacion {
				background: rgba(16, 185, 129, 0.12);
				color: #059669;
				border-color: rgba(16, 185, 129, 0.25);
			}
			:global(html.dark) .category-badge.divulgacion {
				color: #34d399;
			}
			.category-badge.miscelanea {
				background: rgba(107, 114, 128, 0.12);
				color: #4b5563;
				border-color: rgba(107, 114, 128, 0.25);
			}
			:global(html.dark) .category-badge.miscelanea {
				color: #9ca3af;
			}
			.category-badge.mi-pc {
				background: rgba(245, 158, 11, 0.12);
				color: #d97706;
				border-color: rgba(245, 158, 11, 0.25);
			}
			:global(html.dark) .category-badge.mi-pc {
				color: #fbbf24;
			}
			.category-badge.homelab {
				background: rgba(20, 184, 166, 0.12);
				color: #0d9488;
				border-color: rgba(20, 184, 166, 0.25);
			}
			:global(html.dark) .category-badge.homelab {
				color: #2dd4bf;
			}
			.pinned-badge {
				display: inline-block;
				padding: 0.2rem 0.5rem;
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				border-radius: 4px;
				background: rgba(245, 158, 11, 0.12);
				color: #d97706;
				border: 1px solid rgba(245, 158, 11, 0.3);
			}
			:global(html.dark) .pinned-badge {
				color: #fbbf24;
			}

			@media (max-width: 820px) {
				.featured-card {
					grid-template-columns: 1fr;
				}
				.featured-image-wrapper {
					aspect-ratio: 16 / 9;
					min-height: auto;
				}
				.featured-content {
					padding: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="category-tabs">
				<a href="/" class="active">Todos</a>
				<a href="/blog/category/proyectos">Proyectos</a>
				<a href="/blog/category/divulgacion">Divulgación</a>
				<a href="/blog/category/miscelanea">Miscelánea</a>
				<a href="/blog/category/mi-pc">Mi PC</a>
				<a href="/blog/category/homelab">HomeLab</a>
			</div>

			{featuredPost && (
				<section class="featured-section">
					<a href={`/blog/${featuredPost.id}/`} class="featured-card">
						<div class="featured-image-wrapper">
							<img src={featuredPost.data.heroImage} alt={featuredPost.data.title} />
						</div>
						<div class="featured-content">
							<div class="card-meta">
								{featuredPost.data.pinned && (
									<span class="pinned-badge">Fijado</span>
								)}
								<span class={`category-badge ${featuredPost.data.category}`}>
									{categoryTitles[featuredPost.data.category] || featuredPost.data.category}
								</span>
								<span class="reading-time">⏱️ {getReadingTime(featuredPost.body)}</span>
							</div>
							<h2 class="featured-title">{featuredPost.data.title}</h2>
							<p class="featured-desc">{featuredPost.data.description}</p>
							<div class="featured-footer">
								<span><FormattedDate date={featuredPost.data.pubDate} /></span>
								<span class="read-action">Leer artículo →</span>
							</div>
						</div>
					</a>
				</section>
			)}

			<section>
				<div class="posts-grid">
					{regularPosts.map((post) => (
						<a href={`/blog/${post.id}/`} class="post-card">
							<div class="card-image-wrapper">
								<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
							</div>
							<div class="card-content">
								<div class="card-meta">
									{post.data.pinned && (
										<span class="pinned-badge">Fijado</span>
									)}
									<span class={`category-badge ${post.data.category}`}>
										{categoryTitles[post.data.category] || post.data.category}
									</span>
									<span class="reading-time">⏱️ {getReadingTime(post.body)}</span>
								</div>
								<h3 class="card-title">{post.data.title}</h3>
								<p class="card-desc">{post.data.description}</p>
								<div class="card-footer">
									<span><FormattedDate date={post.data.pubDate} /></span>
									<span class="read-action">Leer →</span>
								</div>
							</div>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
