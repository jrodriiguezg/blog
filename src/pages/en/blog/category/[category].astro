---
import { getCollection } from 'astro:content';
import BaseHead from '../../../../components/BaseHead.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../../../consts';
import FormattedDate from '../../../../components/FormattedDate.astro';

export async function getStaticPaths() {
	const categories = ['proyectos', 'divulgacion', 'miscelanea', 'workstation', 'infraestructura'];
	return categories.map((category) => ({
		params: { category },
		props: { categoryName: category },
	}));
}

const { category } = Astro.params;

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((post) => post.id.startsWith('en/') && post.data.category === category && (!import.meta.env.PROD || !post.data.draft))
	.sort((a, b) => {
		if (a.data.pinned && !b.data.pinned) return -1;
		if (!a.data.pinned && b.data.pinned) return 1;
		return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
	});

function getReadingTime(body?: string) {
	if (!body) return '3 min';
	const words = body.trim().split(/\s+/).length;
	const minutes = Math.max(1, Math.ceil(words / 200));
	return `${minutes} min read`;
}

const categoryTitles: Record<string, string> = {
	proyectos: 'Projects',
	divulgacion: 'Articles',
	miscelanea: 'Miscellaneous',
	workstation: 'Workstation',
	infraestructura: 'Infrastructure',
};
const displayTitle = categoryTitles[category] || category;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${displayTitle} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.category-filters {
				display: flex;
				flex-wrap: wrap;
				gap: 1.25rem;
				margin-bottom: 2rem;
				padding-bottom: 0.65rem;
				border-bottom: 1px solid var(--border-color);
				font-size: 0.88rem;
			}

			.filter-link {
				color: var(--text-muted);
				text-decoration: none;
				padding-bottom: 0.65rem;
				margin-bottom: -0.65rem;
				border-bottom: 2px solid transparent;
				transition: color 0.15s ease, border-color 0.15s ease;
			}

			.filter-link:hover {
				color: var(--title-color);
			}

			.filter-link.active {
				color: var(--title-color);
				border-bottom-color: var(--accent);
				font-weight: 500;
			}

			.posts-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.post-item {
				padding: 1.4rem 0;
				border-bottom: 1px solid var(--border-color);
			}

			.post-item:first-child {
				padding-top: 0.25rem;
			}

			.post-row {
				display: flex;
				flex-direction: column;
			}

			.post-meta-top {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.45rem;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--text-muted);
				margin-bottom: 0.35rem;
			}

			.meta-separator {
				color: var(--border-color);
				user-select: none;
			}

			.pinned-tag {
				color: var(--accent);
				font-weight: 600;
				text-transform: uppercase;
				font-size: 0.72rem;
			}

			.post-title {
				font-size: 1.15rem;
				font-weight: 600;
				line-height: 1.35;
				margin: 0 0 0.35rem 0;
				letter-spacing: -0.01em;
			}

			.post-title a {
				color: var(--title-color);
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.post-title a:hover {
				color: var(--accent);
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
			}

			.post-excerpt {
				font-size: 0.92rem;
				color: var(--text-muted);
				line-height: 1.55;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.empty-message {
				padding: 3rem 0;
				text-align: center;
				color: var(--text-muted);
				font-size: 0.95rem;
			}

			@media (max-width: 640px) {
				.category-filters {
					gap: 0.85rem;
					font-size: 0.84rem;
				}
				.post-item {
					padding: 1.15rem 0;
				}
				.post-title {
					font-size: 1.05rem;
				}
				.post-excerpt {
					font-size: 0.88rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<nav class="category-filters" aria-label="Category filters">
				<a href="/en" class="filter-link">All</a>
				<a href="/en/blog/category/proyectos" class={`filter-link ${category === 'proyectos' ? 'active' : ''}`}>Projects</a>
				<a href="/en/blog/category/divulgacion" class={`filter-link ${category === 'divulgacion' ? 'active' : ''}`}>Articles</a>
				<a href="/en/blog/category/miscelanea" class={`filter-link ${category === 'miscelanea' ? 'active' : ''}`}>Miscellaneous</a>
				<a href="/en/blog/category/workstation" class={`filter-link ${category === 'workstation' ? 'active' : ''}`}>Workstation</a>
				<a href="/en/blog/category/infraestructura" class={`filter-link ${category === 'infraestructura' ? 'active' : ''}`}>Infrastructure</a>
			</nav>

			{posts.length > 0 ? (
				<ul class="posts-list">
					{posts.map((post) => (
						<li class="post-item">
							<article class="post-row">
								<div class="post-meta-top">
									<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
									<span class="meta-separator">/</span>
									<span class="post-category">{categoryTitles[post.data.category] || post.data.category}</span>
									<span class="meta-separator">/</span>
									<span class="post-time">{getReadingTime(post.body)}</span>
									{post.data.pinned && (
										<>
											<span class="meta-separator">/</span>
											<span class="pinned-tag">[pinned]</span>
										</>
									)}
								</div>
								<h2 class="post-title">
									<a href={`/en/blog/${post.id.replace(/^en\//, '')}/`}>{post.data.title}</a>
								</h2>
								{post.data.description && (
									<p class="post-excerpt">{post.data.description}</p>
								)}
							</article>
						</li>
					))}
				</ul>
			) : (
				<p class="empty-message">No articles found in this category.</p>
			)}
		</main>
		<Footer />
	</body>
</html>
