---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import BackToTop from '../components/BackToTop.astro';
import Lightbox from '../components/Lightbox.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/ui';
import { GISCUS_REPO, GISCUS_REPO_ID, GISCUS_CATEGORY, GISCUS_CATEGORY_ID } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: { depth: number; slug: string; text: string }[];
	body?: string;
	relatedPosts?: CollectionEntry<'blog'>[];
};

const { title, description, pubDate, updatedDate, heroImage, category, tags = [], headings = [], body = '', relatedPosts = [] } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = useTranslatedPath(lang);

function getReadingTime(text?: string) {
	if (!text) return lang === 'en' ? '3 min read' : '3 min de lectura';
	const words = text.trim().split(/\s+/).length;
	const minutes = Math.max(1, Math.ceil(words / 200));
	return lang === 'en' ? `${minutes} min read` : `${minutes} min de lectura`;
}
const readingTime = getReadingTime(body);

const categoryTitles: Record<string, Record<string, string>> = {
	es: {
		proyectos: 'Proyectos',
		divulgacion: 'Divulgación',
		miscelanea: 'Miscelánea',
		'mi-pc': 'Mi PC',
		homelab: 'HomeLab',
	},
	en: {
		proyectos: 'Projects',
		divulgacion: 'Articles',
		miscelanea: 'Miscellaneous',
		'mi-pc': 'My PC',
		homelab: 'HomeLab',
	}
};

const activeCategoryTitles = categoryTitles[lang] || categoryTitles.es;
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			.post-page-main {
				width: 100%;
				max-width: 1120px;
				margin: 0 auto;
				padding: 2.5rem 1.5rem 5rem 1.5rem;
			}
			.post-layout-grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 230px;
				gap: 3rem;
				align-items: start;
			}
			.post-main-column {
				min-width: 0;
			}
			.post-sidebar-aside {
				position: sticky;
				top: 5.5rem;
			}
			@media (max-width: 1024px) {
				.post-layout-grid {
					grid-template-columns: minmax(0, 1fr);
				}
				.post-sidebar-aside {
					display: none;
				}
			}
			.date-row {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 0.5rem;
				font-size: 0.9rem;
				color: var(--text-muted);
			}
			.meta-dot {
				color: var(--border-color);
			}
			.reading-badge {
				color: var(--text-muted);
				font-size: 0.88rem;
			}
			.related-section {
				margin-top: 3.5rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border-color);
			}
			.related-title {
				font-size: 1.25rem;
				font-weight: 700;
				margin-bottom: 1.25rem;
				color: var(--title-color);
			}
			.related-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 1.25rem;
			}
			.related-card {
				display: flex;
				flex-direction: column;
				background: var(--surface-color);
				border: 1px solid var(--border-color);
				border-radius: var(--radius);
				padding: 1.25rem;
				text-decoration: none;
				color: inherit;
				transition: border-color 0.2s ease, transform 0.2s ease;
			}
			.related-card:hover {
				border-color: var(--accent);
				transform: translateY(-2px);
			}
			.related-card-title {
				font-size: 1rem;
				font-weight: 600;
				color: var(--title-color);
				margin-bottom: 0.5rem;
				line-height: 1.35;
				transition: color 0.2s ease;
			}
			.related-card:hover .related-card-title {
				color: var(--accent);
			}
			.related-card-meta {
				font-size: 0.8rem;
				color: var(--text-muted);
				margin-top: auto;
			}
			.hero-image {
				width: 100%;
				max-width: 1020px;
				margin: 0 auto 2rem auto;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 21 / 9;
				object-fit: cover;
				object-position: center;
				max-height: 360px;
				border-radius: var(--radius);
				border: 1px solid var(--border-color);
				box-shadow: var(--box-shadow);
			}
			.reading-progress-bar {
				position: fixed;
				top: 0;
				left: 0;
				height: 3px;
				width: 0%;
				background: var(--accent);
				z-index: 100;
				transition: width 0.1s ease-out;
			}
			:global(.copy-code-btn) {
				position: absolute;
				top: 8px;
				right: 8px;
				display: inline-flex;
				align-items: center;
				gap: 5px;
				padding: 4px 8px;
				font-size: 12px;
				font-weight: 500;
				color: var(--text-muted);
				background: var(--surface-color);
				border: 1px solid var(--border-color);
				border-radius: 6px;
				cursor: pointer;
				opacity: 0;
				transition: opacity 0.2s ease, border-color 0.2s ease, color 0.2s ease;
				z-index: 5;
			}
			:global(pre:hover .copy-code-btn) {
				opacity: 1;
			}
			:global(.copy-code-btn:hover) {
				color: var(--title-color);
				border-color: var(--accent);
			}
			:global(.copy-code-btn.copied) {
				color: #10b981;
				border-color: #10b981;
			}
			.prose {
				width: 820px;
				max-width: 100%;
				margin: auto;
				padding: 0;
				color: var(--text-color);
			}
			.title {
				margin-bottom: 2rem;
				padding: 0;
				text-align: left;
				line-height: 1.3;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.post-metadata {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: flex-start;
				gap: 0.75rem;
				margin-top: 0.5rem;
				margin-bottom: 1.5rem;
			}
			.category-badge {
				display: inline-block;
				padding: 0.25rem 0.75rem;
				font-size: 0.8rem;
				font-weight: 700;
				text-transform: uppercase;
				border-radius: 6px;
				background: rgba(var(--gray-light), 50%);
				color: var(--text-color);
				border: 1px solid rgba(var(--gray), 15%);
				text-decoration: none;
				transition: background-color 0.2s, border-color 0.2s;
			}
			.category-badge:hover {
				background: rgba(var(--gray-light), 80%);
			}
			.category-badge.proyectos {
				background: rgba(59, 130, 246, 15%);
				color: #3b82f6;
				border-color: rgba(59, 130, 246, 30%);
			}
			.category-badge.proyectos:hover {
				background: rgba(59, 130, 246, 25%);
			}
			.category-badge.divulgacion {
				background: rgba(16, 185, 129, 15%);
				color: #10b981;
				border-color: rgba(16, 185, 129, 30%);
			}
			.category-badge.divulgacion:hover {
				background: rgba(16, 185, 129, 25%);
			}
			.category-badge.miscelanea {
				background: rgba(107, 114, 128, 15%);
				color: #6b7280;
				border-color: rgba(107, 114, 128, 30%);
			}
			.category-badge.miscelanea:hover {
				background: rgba(107, 114, 128, 25%);
			}
			.category-badge.mi-pc {
				background: rgba(245, 158, 11, 15%);
				color: #f59e0b;
				border-color: rgba(245, 158, 11, 30%);
			}
			.category-badge.mi-pc:hover {
				background: rgba(245, 158, 11, 25%);
			}
			.category-badge.configuraciones {
				background: rgba(139, 92, 246, 15%);
				color: #8b5cf6;
				border-color: rgba(139, 92, 246, 30%);
			}
			.category-badge.configuraciones:hover {
				background: rgba(139, 92, 246, 25%);
			}
			.category-badge.homelab {
				background: rgba(20, 184, 166, 15%);
				color: #14b8a6;
				border-color: rgba(20, 184, 166, 30%);
			}
			.category-badge.homelab:hover {
				background: rgba(20, 184, 166, 25%);
			}
			.tag-badge {
				font-size: 0.85rem;
				color: var(--accent);
				font-weight: 500;
				text-decoration: none;
			}
			.tag-badge:hover {
				text-decoration: underline;
				color: var(--accent-dark);
			}

			/* Estilos para Diagramas de Mermaid */
			.mermaid {
				width: 100%;
				background: transparent !important;
				border: none !important;
				border-radius: 0 !important;
				padding: 0 !important;
				box-shadow: none !important;
				display: flex;
				justify-content: center;
				align-items: center;
				overflow-x: auto;
				margin: 2.5rem 0;
			}
			.mermaid svg {
				max-width: 100% !important;
				height: auto !important;
				min-width: 600px; /* Evita que el diagrama se encoja a tamaños ilegibles en pantallas medianas/pequeñas */
			}

			/* Breakout panorámico para pantallas grandes (alineado con la imagen de portada de 1020px) */
			@media (min-width: 1060px) {
				.mermaid {
					width: 1020px !important;
					max-width: 1020px !important;
					margin-left: calc(50% - 510px) !important;
					margin-right: calc(50% - 510px) !important;
					padding: 0 !important;
				}
				.mermaid svg {
					min-width: 800px;
				}
			}
		</style>
		<style is:global>
			/* Estilos de Comentarios (Completamente Planos, Transparentes y Globales) */
			.comments-divider {
				margin: 3.5rem 0 2rem 0;
				border: 0;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
			}
			.comments-section {
				margin-top: 2rem;
			}
			.comments-section h3 {
				margin-bottom: 1.5rem;
				font-size: 1.5rem;
				color: var(--title-color);
			}
			.comments-list {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				margin-bottom: 2.5rem;
			}
			.no-comments {
				color: rgb(var(--gray));
				font-style: italic;
				margin-bottom: 1.5rem;
				font-size: 0.95rem;
			}
			.comment-item {
				background: transparent;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				padding-bottom: 1.25rem;
			}
			.comment-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.6rem;
			}
			.comment-author-info {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}
			.comment-avatar {
				width: 32px;
				height: 32px;
				background: #1e1e24;
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.85rem;
				font-weight: 700;
				color: var(--title-color);
			}
			.comment-author-name {
				font-weight: 600;
				color: var(--title-color);
				font-size: 0.95rem;
			}
			.comment-date {
				font-size: 0.8rem;
				color: rgb(var(--gray));
			}
			.comment-body {
				font-size: 0.95rem;
				line-height: 1.6;
				color: var(--text-color);
				padding-left: 2.5rem;
				word-break: break-word;
			}
			
			/* Formulario de Comentarios */
			.comment-form {
				background: transparent;
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 8px;
				padding: 1.5rem;
				margin-top: 3rem;
			}
			.comment-form h4 {
				margin-top: 0;
				margin-bottom: 1.25rem;
				font-size: 1.15rem;
				color: var(--title-color);
			}
			.form-group {
				margin-bottom: 1.25rem;
			}
			.form-group label {
				display: block;
				margin-bottom: 0.4rem;
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--title-color);
			}
			.form-group input,
			.form-group textarea {
				width: 100%;
				background: #09090b;
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 6px;
				padding: 0.6rem 0.8rem;
				color: #ffffff;
				font-family: inherit;
				font-size: 0.95rem;
				transition: border-color 0.2s ease, outline 0.2s ease;
			}
			.form-group input:focus,
			.form-group textarea:focus {
				border-color: var(--accent);
				outline: 1px solid var(--accent);
			}
			.submit-btn {
				background: var(--accent);
				color: #ffffff;
				border: none;
				border-radius: 6px;
				padding: 0.7rem 1.25rem;
				font-size: 0.95rem;
				font-weight: 600;
				cursor: pointer;
				transition: background-color 0.2s ease;
			}
			.submit-btn:hover {
				background: var(--accent-dark);
			}
			.submit-btn:disabled {
				background: #27272a;
				color: #71717a;
				cursor: not-allowed;
			}
			.comment-message {
				margin-top: 1rem;
				font-size: 0.9rem;
				font-weight: 500;
			}
			.comment-message.success {
				color: #10b981;
			}
			.comment-message.error {
				color: #ef4444;
			}
		</style>
	</head>

	<body>
		<ReadingProgress />
		<Header />
		<main class="post-page-main">
			<div class="post-layout-grid">
				<article class="post-main-column">
					<div class="hero-image">
						{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
					</div>
					<div class="prose">
						<div class="title">
							<div class="date-row">
								<FormattedDate date={pubDate} />
								<span class="meta-dot">·</span>
								<span class="reading-badge">{readingTime}</span>
								{
									updatedDate && (
										<span class="meta-dot">·</span>
										<span class="last-updated-on">
											{lang === 'en' ? 'Updated' : 'Actualizado'} <FormattedDate date={updatedDate} />
										</span>
									)
								}
							</div>
							<h1>{title}</h1>
							<div class="post-metadata">
								{category && (
									<a href={l(`/blog/category/${category}`)} class={`category-badge ${category}`}>
										{activeCategoryTitles[category] || category}
									</a>
								)}
								{tags.map((tag) => (
									<a href={l(`/blog/tag/${tag}`)} class="tag-badge">#{tag}</a>
								))}
							</div>
							<hr />
						</div>
						<slot />

						{relatedPosts && relatedPosts.length > 0 && (
							<section class="related-section">
								<h3 class="related-title">{lang === 'en' ? 'Related Articles' : 'Artículos relacionados'}</h3>
								<div class="related-grid">
									{relatedPosts.map((rel) => (
										<a href={l(`/blog/${rel.id.replace(/^en\//, '')}/`)} class="related-card">
											<h4 class="related-card-title">{rel.data.title}</h4>
											<div class="related-card-meta">
												<FormattedDate date={rel.data.pubDate} />
											</div>
										</a>
									))}
								</div>
							</section>
						)}

						<!-- Sección de Comentarios con Giscus -->
						<hr class="comments-divider" />
						<section class="comments-section">
							<h3>{t('comments.title')}</h3>
							<div 
								class="giscus"
								data-repo={GISCUS_REPO}
								data-repo-id={GISCUS_REPO_ID}
								data-category={GISCUS_CATEGORY}
								data-category-id={GISCUS_CATEGORY_ID}
								data-mapping="pathname"
								data-strict="0"
								data-reactions-enabled="1"
								data-emit-metadata="0"
								data-input-position="bottom"
								data-theme="transparent_dark"
								data-lang={lang}
							></div>
							<div class="giscus-warning" style="display: none; padding: 1.5rem; border: 1px dashed var(--accent); border-radius: 8px; margin-top: 1.5rem; color: var(--text-color);">
								<h4 style="margin: 0 0 0.5rem 0; color: var(--title-color);">{t('comments.giscusPendingTitle')}</h4>
								<p style="margin: 0; font-size: 0.9rem; line-height: 1.5;">
									{t('comments.giscusPendingDesc')}
								</p>
							</div>
						</section>
					</div>
				</article>

				{headings && headings.length > 0 && (
					<aside class="post-sidebar-aside">
						<TableOfContents headings={headings} lang={lang} />
					</aside>
				)}
			</div>
		</main>
		<BackToTop />
		<Lightbox />
		<Footer />
		<script>
			import mermaid from 'mermaid';
			
			// Inicializar mermaid para buscar y renderizar elementos con clase "mermaid"
			mermaid.initialize({
				startOnLoad: true,
				theme: 'dark',
			});

			// Lógica para inicializar y gestionar Giscus
			const giscusContainer = document.querySelector('.giscus') as HTMLElement;
			const giscusWarning = document.querySelector('.giscus-warning') as HTMLElement;

			if (giscusContainer) {
				const repo = giscusContainer.getAttribute('data-repo');
				const repoId = giscusContainer.getAttribute('data-repo-id');
				const category = giscusContainer.getAttribute('data-category');
				const categoryId = giscusContainer.getAttribute('data-category-id');
				const mapping = giscusContainer.getAttribute('data-mapping') || 'pathname';
				const reactionsEnabled = giscusContainer.getAttribute('data-reactions-enabled') || '1';
				const emitMetadata = giscusContainer.getAttribute('data-emit-metadata') || '0';
				const inputPosition = giscusContainer.getAttribute('data-input-position') || 'bottom';
				const lang = giscusContainer.getAttribute('data-lang') || 'es';

				// Si no hay id de categoría configurado, mostramos advertencia al usuario y no cargamos Giscus
				if (!categoryId) {
					if (giscusWarning) giscusWarning.style.display = 'block';
				} else {
					// Determinar el tema de giscus en función de la clase dark de html
					const isDark = document.documentElement.classList.contains('dark');
					const theme = isDark ? 'transparent_dark' : 'light';

					const script = document.createElement('script');
					script.src = 'https://giscus.app/client.js';
					script.setAttribute('data-repo', repo || '');
					script.setAttribute('data-repo-id', repoId || '');
					script.setAttribute('data-category', category || '');
					script.setAttribute('data-category-id', categoryId || '');
					script.setAttribute('data-mapping', mapping);
					script.setAttribute('data-strict', '0');
					script.setAttribute('data-reactions-enabled', reactionsEnabled);
					script.setAttribute('data-emit-metadata', emitMetadata);
					script.setAttribute('data-input-position', inputPosition);
					script.setAttribute('data-theme', theme);
					script.setAttribute('data-lang', lang);
					script.setAttribute('crossorigin', 'anonymous');
					script.async = true;

					document.head.appendChild(script);

					// Sincronizar el tema de Giscus cuando cambie el tema del sitio
					const observer = new MutationObserver(() => {
						const nextTheme = document.documentElement.classList.contains('dark') ? 'transparent_dark' : 'light';
						const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
						if (iframe && iframe.contentWindow) {
							iframe.contentWindow.postMessage(
								{ giscus: { setConfig: { theme: nextTheme } } },
								'https://giscus.app'
							);
						}
					});

					observer.observe(document.documentElement, {
						attributes: true,
						attributeFilter: ['class'],
					});
				}
			}

			// Barra de progreso de lectura
			const progressBar = document.getElementById('reading-progress');
			if (progressBar) {
				window.addEventListener('scroll', () => {
					const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
					if (totalHeight > 0) {
						const progress = (window.scrollY / totalHeight) * 100;
						progressBar.style.width = `${progress}%`;
					}
				}, { passive: true });
			}

			// Botón para copiar código en bloques <pre>
			const isEn = window.location.pathname.startsWith('/en');
			const copyLabel = isEn ? 'Copy' : 'Copiar';
			const copiedLabel = isEn ? 'Copied!' : '¡Copiado!';

			document.querySelectorAll('.prose pre').forEach((pre) => {
				const wrapper = document.createElement('div');
				wrapper.className = 'code-block-wrapper';
				wrapper.style.position = 'relative';
				pre.parentNode?.insertBefore(wrapper, pre);
				wrapper.appendChild(pre);

				const btn = document.createElement('button');
				btn.className = 'copy-code-btn';
				btn.type = 'button';
				btn.innerText = copyLabel;
				btn.setAttribute('aria-label', copyLabel);
				wrapper.appendChild(btn);

				btn.addEventListener('click', async () => {
					const code = pre.querySelector('code')?.innerText || pre.innerText;
					try {
						await navigator.clipboard.writeText(code);
						btn.innerText = copiedLabel;
						btn.classList.add('copied');
						setTimeout(() => {
							btn.innerText = copyLabel;
							btn.classList.remove('copied');
						}, 2000);
					} catch (e) {
						btn.innerText = 'Error';
					}
				});
			});
		</script>
