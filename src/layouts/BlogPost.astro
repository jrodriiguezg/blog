---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import BackToTop from '../components/BackToTop.astro';
import Lightbox from '../components/Lightbox.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/ui';
import { GISCUS_REPO, GISCUS_REPO_ID, GISCUS_CATEGORY, GISCUS_CATEGORY_ID, SHOW_COVERS } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	id?: string;
	headings?: { depth: number; slug: string; text: string }[];
	body?: string;
	relatedPosts?: CollectionEntry<'blog'>[];
};

const { id, title, description, pubDate, updatedDate, heroImage, category, tags = [], headings = [], body = '', relatedPosts = [] } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = useTranslatedPath(lang);

function getReadingTime(text?: string) {
	if (!text) return lang === 'en' ? '3 min read' : '3 min de lectura';
	const words = text.trim().split(/\s+/).length;
	const minutes = Math.max(1, Math.ceil(words / 200));
	return lang === 'en' ? `${minutes} min read` : `${minutes} min de lectura`;
}
const readingTime = getReadingTime(body);

const categoryTitles: Record<string, Record<string, string>> = {
	es: {
		proyectos: 'Proyectos',
		divulgacion: 'Divulgación',
		miscelanea: 'Miscelánea',
		workstation: 'Workstation',
		infraestructura: 'Infraestructura',
	},
	en: {
		proyectos: 'Projects',
		divulgacion: 'Articles',
		miscelanea: 'Miscellaneous',
		workstation: 'Workstation',
		infraestructura: 'Infrastructure',
	}
};

const activeCategoryTitles = categoryTitles[lang] || categoryTitles.es;

// Imagen social generada para Open Graph y Twitter Cards con cache-busting (?v=2)
const ogImage = id ? `/og/${id}.png?v=2` : '/og/default.png?v=2';
const ogImageAbsolute = new URL(ogImage, Astro.site).toString();

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	'headline': title,
	'description': description,
	'image': [ogImageAbsolute],
	'datePublished': pubDate.toISOString(),
	...(updatedDate ? { 'dateModified': updatedDate.toISOString() } : {}),
	'author': {
		'@type': 'Person',
		'name': 'jrodriiguezg',
		'url': 'https://jrodriiguezg.link',
	},
	'mainEntityOfPage': {
		'@type': 'WebPage',
		'@id': new URL(Astro.url.pathname, Astro.site).toString(),
	},
};
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={ogImage} imageAlt={title} type="article" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			.post-page-main {
				width: 100%;
				max-width: var(--container-width);
				margin: 0 auto;
				padding: 3rem 1.25rem 5rem 1.25rem;
				position: relative;
				box-sizing: border-box;
			}

			.post-main-column {
				min-width: 0;
				max-width: 100%;
			}

			/* Sidebar TOC en gutter derecho para pantallas panorámicas */
			.post-sidebar-aside {
				display: none;
			}

			@media (min-width: 1240px) {
				.post-sidebar-aside {
					display: block;
					position: absolute;
					top: 3rem;
					left: calc(100% + 2.5rem);
					width: 220px;
				}
			}

			@media (max-width: 720px) {
				.post-page-main {
					padding: 1.75rem 1rem 3.5rem 1rem;
				}
				.post-title {
					font-size: 1.7rem;
				}
			}

			@media (max-width: 480px) {
				.post-page-main {
					padding: 1.25rem 0.85rem 3rem 0.85rem;
				}
				.post-title {
					font-size: 1.45rem;
				}
			}

			/* Cabecera del artículo */
			.post-header {
				margin-bottom: 2rem;
			}

			.post-meta-row {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 0.65rem;
				font-family: var(--font-mono);
				font-size: 0.82rem;
				color: var(--text-muted);
			}

			.meta-dot {
				color: var(--border-color);
				user-select: none;
			}

			.reading-badge {
				color: var(--text-muted);
			}

			.last-updated-on {
				font-style: normal;
				color: var(--text-muted);
			}

			.post-title {
				font-size: 2.1rem;
				font-weight: 600;
				line-height: 1.25;
				color: var(--title-color);
				margin: 0 0 1rem 0;
				letter-spacing: -0.02em;
			}

			/* Taxonomías del post: Categoría y Etiquetas */
			.post-taxonomies {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 1rem;
				margin-top: 0.75rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--border-color);
			}

			.post-category {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				font-weight: 500;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				text-decoration: none !important;
				background: none;
				border: none;
				padding: 0;
				transition: color 0.15s ease;
			}

			.post-category:hover {
				color: var(--title-color);
				text-decoration: underline !important;
				text-underline-offset: 3px !important;
			}

			.post-tags {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.65rem;
			}

			.post-tag {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--text-muted);
				text-decoration: none !important;
				background: none;
				border: none;
				padding: 0;
				transition: color 0.15s ease;
			}

			.post-tag:hover {
				color: var(--accent);
				text-decoration: underline !important;
				text-underline-offset: 3px !important;
			}

			/* Portada opcional (detrás del flag SHOW_COVERS) */
			.hero-image {
				width: 100%;
				max-width: 100%;
				margin: 0 auto 2rem auto;
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 21 / 9;
				object-fit: cover;
				object-position: center;
				max-height: 380px;
				border-radius: var(--radius);
				border: 1px solid var(--border-color);
				box-shadow: none;
			}

			/* Imágenes dentro del contenido del post */
			.prose :global(img) {
				max-width: 100%;
				height: auto;
				display: block;
				margin: 2rem auto;
				border: 1px solid var(--border-color);
				border-radius: var(--radius);
				box-shadow: none;
			}

			/* Barra de progreso de lectura */
			.reading-progress-bar {
				position: fixed;
				top: 0;
				left: 0;
				height: 2px;
				width: 0%;
				background: var(--accent);
				z-index: 100;
				transition: width 0.1s ease-out;
			}

			/* Botón para copiar código en pre */
			:global(.copy-code-btn) {
				position: absolute;
				top: 8px;
				right: 8px;
				display: inline-flex;
				align-items: center;
				gap: 5px;
				padding: 3px 8px;
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				color: var(--text-muted);
				background: var(--surface-color);
				border: 1px solid var(--border-color);
				border-radius: var(--radius-sm);
				cursor: pointer;
				opacity: 0;
				transition: opacity 0.15s ease, border-color 0.15s ease, color 0.15s ease;
				z-index: 5;
			}

			:global(pre:hover .copy-code-btn) {
				opacity: 1;
			}

			:global(.copy-code-btn:hover) {
				color: var(--title-color);
				border-color: var(--border-hover);
			}

			:global(.copy-code-btn.copied) {
				color: var(--title-color);
				border-color: var(--accent);
			}

			/* Artículos relacionados - Lista editorial sobria */
			.related-section {
				margin-top: 3.5rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border-color);
			}

			.related-title {
				font-size: 1.15rem;
				font-weight: 600;
				margin-bottom: 1rem;
				color: var(--title-color);
				letter-spacing: -0.01em;
			}

			.related-list {
				list-style: none;
				padding: 0;
				margin: 0;
				border-top: 1px solid var(--border-color);
			}

			.related-item {
				padding: 0.85rem 0;
				border-bottom: 1px solid var(--border-color);
			}

			.related-item-link {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				text-decoration: none !important;
				color: var(--title-color);
				transition: color 0.15s ease;
			}

			.related-item-link:hover .related-item-title {
				color: var(--accent);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.related-item-title {
				font-size: 0.95rem;
				font-weight: 500;
				margin: 0;
				line-height: 1.4;
				color: var(--title-color);
				transition: color 0.15s ease;
			}

			.related-item-date {
				font-family: var(--font-mono);
				font-size: 0.76rem;
				color: var(--text-muted);
				white-space: nowrap;
			}

			@media (max-width: 640px) {
				.related-item-link {
					flex-direction: column;
					gap: 0.25rem;
				}
			}
		</style>
		<style is:global>
			/* Diagramas de Mermaid */
			.mermaid {
				width: 100%;
				max-width: 100%;
				margin: 2.25rem 0;
				padding: 1.25rem;
				background: var(--surface-color);
				border: 1px solid var(--border-color);
				border-radius: var(--radius);
				display: flex;
				justify-content: center;
				align-items: center;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
				box-sizing: border-box;
				font-family: var(--font-mono);
				font-size: 0.82rem;
				line-height: 1.5;
				white-space: pre-wrap;
				min-height: 120px;
				transition: background-color 0.2s ease, border-color 0.2s ease;
			}

			.mermaid.mermaid-rendered {
				white-space: normal;
			}

			.mermaid svg {
				max-width: 100% !important;
				height: auto !important;
				display: block;
				margin: 0 auto;
			}

			/* Fallback en caso de error de sintaxis en el diagrama */
			.mermaid-fallback {
				width: 100%;
				margin: 0;
				padding: 1rem;
				background: transparent;
				border: none;
				border-radius: 0;
				color: var(--text-color);
				font-family: var(--font-mono);
				font-size: 0.8rem;
				overflow-x: auto;
				white-space: pre;
			}

			.mermaid-error-badge {
				display: block;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--text-muted);
				margin-bottom: 0.5rem;
			}

			/* Estilos de Comentarios (Planos y basados en tokens) */
			.comments-divider {
				margin: 3.5rem 0 2rem 0;
				border: 0;
				border-top: 1px solid var(--border-color);
			}

			.comments-section {
				margin-top: 2rem;
			}

			.comments-section h3 {
				margin-bottom: 1.5rem;
				font-size: 1.3rem;
				color: var(--title-color);
				letter-spacing: -0.01em;
			}

			.comments-list {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				margin-bottom: 2.5rem;
			}

			.no-comments {
				color: var(--text-muted);
				font-style: italic;
				margin-bottom: 1.5rem;
				font-size: 0.9rem;
			}

			.comment-item {
				background: transparent;
				border-bottom: 1px solid var(--border-color);
				padding-bottom: 1.25rem;
			}

			.comment-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.6rem;
			}

			.comment-author-info {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.comment-avatar {
				width: 30px;
				height: 30px;
				background: var(--surface-color);
				border: 1px solid var(--border-color);
				border-radius: var(--radius-sm);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.8rem;
				font-weight: 600;
				color: var(--title-color);
			}

			.comment-author-name {
				font-weight: 600;
				color: var(--title-color);
				font-size: 0.92rem;
			}

			.comment-date {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--text-muted);
			}

			.comment-body {
				font-size: 0.95rem;
				line-height: 1.6;
				color: var(--text-color);
				padding-left: 2.25rem;
				word-break: break-word;
			}
			
			/* Formulario de comentarios */
			.comment-form {
				background: var(--surface-color);
				border: 1px solid var(--border-color);
				border-radius: var(--radius);
				padding: 1.25rem;
				margin-top: 2.5rem;
			}

			.comment-form h4 {
				margin-top: 0;
				margin-bottom: 1rem;
				font-size: 1.05rem;
				color: var(--title-color);
			}

			.form-group {
				margin-bottom: 1rem;
			}

			.form-group label {
				display: block;
				margin-bottom: 0.35rem;
				font-size: 0.82rem;
				font-weight: 500;
				color: var(--text-muted);
			}

			.form-group input,
			.form-group textarea {
				width: 100%;
				background: var(--bg-color);
				border: 1px solid var(--border-color);
				border-radius: var(--radius-sm);
				padding: 0.5rem 0.75rem;
				color: var(--text-color);
				font-family: inherit;
				font-size: 0.9rem;
				transition: border-color 0.15s ease;
			}

			.form-group input:focus,
			.form-group textarea:focus {
				border-color: var(--accent);
				outline: 2px solid var(--accent);
				outline-offset: 1px;
			}

			.submit-btn {
				background: var(--surface-hover);
				color: var(--title-color);
				border: 1px solid var(--border-color);
				border-radius: var(--radius-sm);
				padding: 0.5rem 1rem;
				font-size: 0.88rem;
				font-weight: 500;
				cursor: pointer;
				transition: border-color 0.15s ease, color 0.15s ease;
			}

			.submit-btn:hover {
				border-color: var(--border-hover);
				color: var(--title-color);
			}

			.submit-btn:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}

			.comment-message {
				margin-top: 0.75rem;
				font-size: 0.85rem;
				color: var(--text-muted);
			}
		</style>
	</head>

	<body>
		<ReadingProgress />
		<Header />
		<main class="post-page-main">
			<div class="post-layout-wrapper">
				<article class="post-main-column">
					{SHOW_COVERS && heroImage && (
						<div class="hero-image">
							<img width={1020} height={510} src={heroImage} alt="" />
						</div>
					)}

					<header class="post-header">
						<div class="post-meta-row">
							<FormattedDate date={pubDate} />
							<span class="meta-dot">·</span>
							<span class="reading-badge">{readingTime}</span>
							{
								updatedDate && (
									<>
										<span class="meta-dot">·</span>
										<span class="last-updated-on">
											{lang === 'en' ? 'Updated' : 'Actualizado'} <FormattedDate date={updatedDate} />
										</span>
									</>
								)
							}
						</div>

						<h1 class="post-title">{title}</h1>

						<div class="post-taxonomies">
							{category && (
								<a href={l(`/blog/category/${category}`)} class="post-category">
									{activeCategoryTitles[category] || category}
								</a>
							)}
							{tags && tags.length > 0 && (
								<div class="post-tags">
									{tags.map((tag) => (
										<a href={l(`/blog/tag/${tag}`)} class="post-tag">#{tag}</a>
									))}
								</div>
							)}
						</div>
					</header>

					<div class="prose">
						<slot />
					</div>

					<ShareButtons title={title} lang={lang} />

					{relatedPosts && relatedPosts.length > 0 && (
						<section class="related-section">
							<h3 class="related-title">{lang === 'en' ? 'Related Articles' : 'Artículos relacionados'}</h3>
							<ul class="related-list">
								{relatedPosts.map((rel) => (
									<li class="related-item">
										<a href={l(`/blog/${rel.id.replace(/^en\//, '')}/`)} class="related-item-link">
											<span class="related-item-title">{rel.data.title}</span>
											<span class="related-item-date"><FormattedDate date={rel.data.pubDate} /></span>
										</a>
									</li>
								))}
							</ul>
						</section>
					)}

					<!-- Sección de Comentarios con Giscus -->
					<hr class="comments-divider" />
					<section class="comments-section">
						<h3>{t('comments.title')}</h3>
						<div 
							class="giscus"
							data-repo={GISCUS_REPO}
							data-repo-id={GISCUS_REPO_ID}
							data-category={GISCUS_CATEGORY}
							data-category-id={GISCUS_CATEGORY_ID}
							data-mapping="pathname"
							data-strict="0"
							data-reactions-enabled="1"
							data-emit-metadata="0"
							data-input-position="bottom"
							data-theme="transparent_dark"
							data-lang={lang}
						></div>
						<div class="giscus-warning" style="display: none; padding: 1.25rem; border: 1px dashed var(--border-color); border-radius: var(--radius); margin-top: 1.5rem; color: var(--text-color);">
							<h4 style="margin: 0 0 0.5rem 0; color: var(--title-color);">{t('comments.giscusPendingTitle')}</h4>
							<p style="margin: 0; font-size: 0.9rem; line-height: 1.5; color: var(--text-muted);">
								{t('comments.giscusPendingDesc')}
							</p>
						</div>
					</section>
				</article>

				{headings && headings.length > 0 && (
					<aside class="post-sidebar-aside">
						<TableOfContents headings={headings} lang={lang} />
					</aside>
				)}
			</div>
		</main>
		<BackToTop />
		<Lightbox />
		<Footer />
		<script>
			// Renderizado dinámico y reactivo de diagramas Mermaid
			const initMermaid = async () => {
				const mermaidElements = Array.from(document.querySelectorAll<HTMLElement>('.mermaid'));
				if (mermaidElements.length === 0) return;

				// Guardar el código original de cada diagrama para permitir re-renderizado al cambiar de tema
				mermaidElements.forEach((el) => {
					if (!el.dataset.mermaidSrc) {
						el.dataset.mermaidSrc = el.textContent || '';
					}
				});

				try {
					const { default: mermaid } = await import('mermaid');

					const renderDiagrams = async () => {
						const isDark = !document.documentElement.classList.contains('light');

						mermaid.initialize({
							startOnLoad: false,
							securityLevel: 'loose',
							theme: 'base',
							themeVariables: {
								darkMode: isDark,
								background: isDark ? '#111214' : '#ffffff',
								mainBkg: isDark ? '#17181a' : '#f9f9f8',
								primaryColor: isDark ? '#17181a' : '#f9f9f8',
								primaryBorderColor: isDark ? '#26282b' : '#e2e2de',
								primaryTextColor: isDark ? '#e6e6e3' : '#1c1d1f',
								secondaryColor: isDark ? '#1e2023' : '#f0f0ed',
								secondaryBorderColor: isDark ? '#26282b' : '#e2e2de',
								secondaryTextColor: isDark ? '#a0a09c' : '#57585a',
								tertiaryColor: isDark ? '#141517' : '#ffffff',
								tertiaryBorderColor: isDark ? '#26282b' : '#e2e2de',
								tertiaryTextColor: isDark ? '#a0a09c' : '#57585a',
								lineColor: isDark ? '#7d9bb8' : '#537496',
								arrowheadColor: isDark ? '#7d9bb8' : '#537496',
								clusterBkg: isDark ? '#141517' : '#f4f4f2',
								clusterBorder: isDark ? '#26282b' : '#e2e2de',
								edgeLabelBackground: isDark ? '#17181a' : '#f9f9f8',
								nodeBorder: isDark ? '#26282b' : '#e2e2de',
								nodeTextColor: isDark ? '#e6e6e3' : '#1c1d1f',
								fontFamily: 'Inter, system-ui, -apple-system, sans-serif',
								fontSize: '13px'
							}
						});

						for (let i = 0; i < mermaidElements.length; i++) {
							const el = mermaidElements[i];
							const code = el.dataset.mermaidSrc || '';
							if (!code.trim()) continue;

							try {
								const id = `mermaid-graph-${i}-${Date.now()}`;
								const { svg } = await mermaid.render(id, code);
								el.innerHTML = svg;
								el.classList.add('mermaid-rendered');
								el.classList.remove('has-error');
							} catch (err) {
								console.warn(`Error al renderizar diagrama Mermaid #${i}:`, err);
								el.classList.add('has-error');
								el.innerHTML = `
									<div style="width: 100%;">
										<span class="mermaid-error-badge">Diagrama (error de sintaxis)</span>
										<pre class="mermaid-fallback"><code>${code.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code></pre>
									</div>
								`;
							}
						}
					};

					await renderDiagrams();

					// Observar cambios de tema (dark/light) en <html class="..."> para re-renderizar
					const themeObserver = new MutationObserver((mutations) => {
						for (const mutation of mutations) {
							if (mutation.attributeName === 'class') {
								renderDiagrams();
								break;
							}
						}
					});

					themeObserver.observe(document.documentElement, {
						attributes: true,
						attributeFilter: ['class']
					});
				} catch (e) {
					console.error('No se pudo cargar la librería Mermaid:', e);
				}
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initMermaid);
			} else {
				initMermaid();
			}
			document.addEventListener('astro:page-load', initMermaid);

			// Lógica para inicializar y gestionar Giscus
			const giscusContainer = document.querySelector('.giscus') as HTMLElement;
			const giscusWarning = document.querySelector('.giscus-warning') as HTMLElement;

			if (giscusContainer) {
				const repo = giscusContainer.getAttribute('data-repo');
				const repoId = giscusContainer.getAttribute('data-repo-id');
				const category = giscusContainer.getAttribute('data-category');
				const categoryId = giscusContainer.getAttribute('data-category-id');
				const mapping = giscusContainer.getAttribute('data-mapping') || 'pathname';
				const reactionsEnabled = giscusContainer.getAttribute('data-reactions-enabled') || '1';
				const emitMetadata = giscusContainer.getAttribute('data-emit-metadata') || '0';
				const inputPosition = giscusContainer.getAttribute('data-input-position') || 'bottom';
				const lang = giscusContainer.getAttribute('data-lang') || 'es';

				if (!categoryId) {
					if (giscusWarning) giscusWarning.style.display = 'block';
				} else {
					const isDark = !document.documentElement.classList.contains('light');
					const theme = isDark ? 'transparent_dark' : 'light';

					const script = document.createElement('script');
					script.src = 'https://giscus.app/client.js';
					script.setAttribute('data-repo', repo || '');
					script.setAttribute('data-repo-id', repoId || '');
					script.setAttribute('data-category', category || '');
					script.setAttribute('data-category-id', categoryId || '');
					script.setAttribute('data-mapping', mapping);
					script.setAttribute('data-strict', '0');
					script.setAttribute('data-reactions-enabled', reactionsEnabled);
					script.setAttribute('data-emit-metadata', emitMetadata);
					script.setAttribute('data-input-position', inputPosition);
					script.setAttribute('data-theme', theme);
					script.setAttribute('data-lang', lang);
					script.setAttribute('crossorigin', 'anonymous');
					script.async = true;

					document.head.appendChild(script);

					// Sincronizar el tema de Giscus cuando cambie el tema del sitio
					const observer = new MutationObserver(() => {
						const nextTheme = !document.documentElement.classList.contains('light') ? 'transparent_dark' : 'light';
						const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
						if (iframe && iframe.contentWindow) {
							iframe.contentWindow.postMessage(
								{ giscus: { setConfig: { theme: nextTheme } } },
								'https://giscus.app'
							);
						}
					});

					observer.observe(document.documentElement, {
						attributes: true,
						attributeFilter: ['class'],
					});
				}
			}

			// Barra de progreso de lectura
			const progressBar = document.getElementById('reading-progress');
			if (progressBar) {
				window.addEventListener('scroll', () => {
					const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
					if (totalHeight > 0) {
						const progress = (window.scrollY / totalHeight) * 100;
						progressBar.style.width = `${progress}%`;
					}
				}, { passive: true });
			}

			// Botón para copiar código en bloques <pre>
			const isEn = window.location.pathname.startsWith('/en');
			const copyLabel = isEn ? 'Copy' : 'Copiar';
			const copiedLabel = isEn ? 'Copied' : 'Copiado';

			document.querySelectorAll('.prose pre').forEach((pre) => {
				const wrapper = document.createElement('div');
				wrapper.className = 'code-block-wrapper';
				wrapper.style.position = 'relative';
				pre.parentNode?.insertBefore(wrapper, pre);
				wrapper.appendChild(pre);

				const btn = document.createElement('button');
				btn.className = 'copy-code-btn';
				btn.type = 'button';
				btn.innerText = copyLabel;
				btn.setAttribute('aria-label', copyLabel);
				wrapper.appendChild(btn);

				btn.addEventListener('click', async () => {
					const code = pre.querySelector('code')?.innerText || pre.innerText;
					try {
						await navigator.clipboard.writeText(code);
						btn.innerText = copiedLabel;
						btn.classList.add('copied');
						setTimeout(() => {
							btn.innerText = copyLabel;
							btn.classList.remove('copied');
						}, 2000);
					} catch (e) {
						btn.innerText = 'Error';
					}
				});
			});
		</script>
	</body>
</html>
